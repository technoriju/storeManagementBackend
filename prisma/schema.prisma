datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// CORE ENTITIES
// ==========================================

model Company {
  id      Int     @id @default(autoincrement())
  name    String
  email   String?
  phone   String?
  gstin   String?
  address String?

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  branches Branch[]
  users    User[]
}

model Branch {
  id        Int     @id @default(autoincrement())
  companyId Int
  name      String
  code      String?
  address   String?
  phone     String?

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  company    Company     @relation(fields: [companyId], references: [id])
  warehouses Warehouse[]
  devices    Device[]
  users      User[]
  purchases  Purchase[]
  sales      Sale[]
  expenses   Expense[]
}

model Warehouse {
  id       Int     @id @default(autoincrement())
  branchId Int
  name     String
  code     String?
  address  String?

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  branch            Branch             @relation(fields: [branchId], references: [id])
  purchases         Purchase[]
  sales             Sale[]
  stockBalances     StockBalance[]
  stockTransactions StockTransaction[]
}

model Device {
  id          Int     @id @default(autoincrement())
  branchId    Int?
  name        String
  deviceToken String? @unique

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  branch Branch? @relation(fields: [branchId], references: [id])
}

model User {
  id           Int     @id @default(autoincrement())
  companyId    Int
  branchId     Int?
  roleId       Int
  username     String  @unique
  passwordHash String
  fullName     String
  email        String?
  phone        String?
  isActive     Boolean @default(true)

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  company       Company        @relation(fields: [companyId], references: [id])
  branch        Branch?        @relation(fields: [branchId], references: [id])
  role          Role           @relation(fields: [roleId], references: [id])
  auditLogs     AuditLog[]
  expenses      Expense[]
  refreshTokens RefreshToken[]
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          Int     @id @default(autoincrement())
  action      String
  description String?

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  roles RolePermission[]
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

// ==========================================
// PRODUCT / UNIT / TAX
// ==========================================

model Category {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  subCategories SubCategory[]
  products      Product[]
}

model SubCategory {
  id          Int     @id @default(autoincrement())
  categoryId  Int
  name        String
  description String?

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  category Category  @relation(fields: [categoryId], references: [id])
  products Product[]
}

model Brand {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  products Product[]
}

model Unit {
  id        Int    @id @default(autoincrement())
  name      String
  shortName String

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  baseProducts      Product[]          @relation("ProductBaseUnit")
  productUnits      ProductUnit[]
  stockTransactions StockTransaction[]
  subUnits          SubUnit[]
}

model SubUnit {
  id           Int    @id @default(autoincrement())
  name         String
  parentUnitId Int
  multiplier   Float  @default(1)

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  parentUnit Unit @relation(fields: [parentUnitId], references: [id])
  products   Product[]

  @@unique([parentUnitId, name])
  @@index([parentUnitId])
}

model TaxRate {
  id       Int     @id @default(autoincrement())
  name     String
  cgstRate Decimal @db.Decimal(5, 2)
  sgstRate Decimal @db.Decimal(5, 2)
  igstRate Decimal @db.Decimal(5, 2)

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  products Product[]
}

enum TaxType {
  GST
  NON_GST
}

model Product {
  id                    BigInt  @id @default(autoincrement())
  categoryId            Int?
  subCategoryId         Int?
  brandId               Int?
  taxRateId             Int?
  baseUnitId            Int
  subUnitId             Int?
  conversionRate        Decimal? @db.Decimal(10, 4) @default(1)
  defaultPurchaseUnitId BigInt?
  defaultSalesUnitId    BigInt?

  name        String
  productCode String  @unique
  sku         String  @unique
  barcode     String? @unique
  description String?
  hsnCode     String?

  taxType          TaxType @default(GST)
  isPriceInclusive Boolean @default(false)
  isActive         Boolean @default(true)

  batchTracking  Boolean @default(false)
  expiryTracking Boolean @default(false)
  serialTracking Boolean @default(false)

  lowStockLevel Decimal? @db.Decimal(12, 4)
  reorderLevel  Decimal? @db.Decimal(12, 4)

  purchasePrice  Decimal? @db.Decimal(12, 2)
  wholesalePrice Decimal? @db.Decimal(12, 2)
  retailPrice    Decimal? @db.Decimal(12, 2)

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  category    Category?    @relation(fields: [categoryId], references: [id])
  subCategory SubCategory? @relation(fields: [subCategoryId], references: [id])
  brand       Brand?       @relation(fields: [brandId], references: [id])
  taxRate     TaxRate?     @relation(fields: [taxRateId], references: [id])
  baseUnit    Unit         @relation("ProductBaseUnit", fields: [baseUnitId], references: [id])
  subUnit     SubUnit?     @relation(fields: [subUnitId], references: [id])

  defaultPurchaseUnit ProductUnit? @relation("DefaultPurchaseUnit", fields: [defaultPurchaseUnitId], references: [id])
  defaultSalesUnit    ProductUnit? @relation("DefaultSalesUnit", fields: [defaultSalesUnitId], references: [id])

  productUnits      ProductUnit[]      @relation("ProductToUnits")
  prices            ProductPrice[]
  purchaseItems     PurchaseItem[]
  saleItems         SaleItem[]
  stockBalances     StockBalance[]
  stockTransactions StockTransaction[]
  saleReturnItems     SaleReturnItem[]
  purchaseReturnItems PurchaseReturnItem[]
  quotationItems      QuotationItem[]
  purchaseOrderItems  PurchaseOrderItem[]

  @@index([name])
}

model ProductUnit {
  id               BigInt  @id @default(autoincrement())
  productId        BigInt
  unitId           Int
  conversionFactor Decimal @db.Decimal(10, 4)

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  product Product @relation("ProductToUnits", fields: [productId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])

  defaultForPurchaseProducts Product[] @relation("DefaultPurchaseUnit")
  defaultForSalesProducts    Product[] @relation("DefaultSalesUnit")

  prices        ProductPrice[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]

  @@unique([productId, unitId])
}

model ProductPrice {
  id            BigInt  @id @default(autoincrement())
  productId     BigInt
  productUnitId BigInt
  priceType     String
  price         Decimal @db.Decimal(12, 2)

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  product     Product     @relation(fields: [productId], references: [id])
  productUnit ProductUnit @relation(fields: [productUnitId], references: [id])

  @@unique([productId, productUnitId, priceType])
}

// ==========================================
// PARTIES
// ==========================================

model Customer {
  id      Int     @id @default(autoincrement())
  name    String
  phone   String?
  email   String?
  address String?
  gstin   String?

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  sales      Sale[]
  quotations Quotation[]
  payments   Payment[]
}

model Supplier {
  id      Int     @id @default(autoincrement())
  name    String
  phone   String?
  email   String?
  address String?
  gstin   String?

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  purchases      Purchase[]
  purchaseOrders PurchaseOrder[]
  payments       Payment[]
}

// ==========================================
// TRANSACTIONS
// ==========================================

model Purchase {
  id            BigInt   @id @default(autoincrement())
  branchId      Int?
  warehouseId   Int?
  supplierId    Int?
  invoiceNumber String
  purchaseDate  DateTime
  status        String   @default("COMPLETED")

  subTotal      Decimal @db.Decimal(12, 2)
  taxTotal      Decimal @db.Decimal(12, 2)
  discountTotal Decimal @db.Decimal(12, 2)
  grandTotal    Decimal @db.Decimal(12, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  branch    Branch?           @relation(fields: [branchId], references: [id])
  warehouse Warehouse?        @relation(fields: [warehouseId], references: [id])
  supplier  Supplier?         @relation(fields: [supplierId], references: [id])
  items     PurchaseItem[]
  payments  PurchasePayment[]
  returns   PurchaseReturn[]
}

model PurchaseItem {
  id            BigInt @id @default(autoincrement())
  purchaseId    BigInt
  productId     BigInt
  productUnitId BigInt?

  quantity  Decimal @db.Decimal(12, 4)
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @db.Decimal(12, 2) @default(0)
  taxAmount Decimal @db.Decimal(12, 2) @default(0)
  total     Decimal @db.Decimal(12, 2)

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  purchase    Purchase     @relation(fields: [purchaseId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])
  productUnit ProductUnit? @relation(fields: [productUnitId], references: [id])
}

model PurchasePayment {
  id         BigInt @id @default(autoincrement())
  purchaseId BigInt
  paymentId  BigInt

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  payment  Payment  @relation(fields: [paymentId], references: [id])
}

model PurchaseReturn {
  id            BigInt               @id @default(autoincrement())
  purchaseId    BigInt
  returnNumber  String?              @unique
  returnDate    DateTime
  reason        String?
  subTotal      Decimal?             @db.Decimal(12, 2)
  taxTotal      Decimal?             @db.Decimal(12, 2)
  discountTotal Decimal?             @db.Decimal(12, 2)
  totalAmount   Decimal              @db.Decimal(12, 2)

  status    String    @default("Received")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  purchase Purchase             @relation(fields: [purchaseId], references: [id])
  items    PurchaseReturnItem[]
}

model PurchaseReturnItem {
  id               BigInt         @id @default(autoincrement())
  purchaseReturnId BigInt
  productId        BigInt
  productUnitId    BigInt?
  quantity         Decimal        @db.Decimal(12, 4)
  unitPrice        Decimal        @db.Decimal(12, 2)
  taxAmount        Decimal        @db.Decimal(12, 2) @default(0)
  discount         Decimal        @db.Decimal(12, 2) @default(0)
  total            Decimal        @db.Decimal(12, 2)

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])
}

model Sale {
  id            BigInt   @id @default(autoincrement())
  branchId      Int?
  warehouseId   Int?
  customerId    Int?
  invoiceNumber String   @unique
  saleDate      DateTime
  status        String   @default("COMPLETED")

  subTotal      Decimal @db.Decimal(12, 2)
  taxTotal      Decimal @db.Decimal(12, 2)
  discountTotal Decimal @db.Decimal(12, 2)
  grandTotal    Decimal @db.Decimal(12, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  branch    Branch?       @relation(fields: [branchId], references: [id])
  warehouse Warehouse?    @relation(fields: [warehouseId], references: [id])
  customer  Customer?     @relation(fields: [customerId], references: [id])
  items     SaleItem[]
  payments  SalePayment[]
  returns   SaleReturn[]
}

model SaleItem {
  id            BigInt @id @default(autoincrement())
  saleId        BigInt
  productId     BigInt
  productUnitId BigInt?

  quantity  Decimal @db.Decimal(12, 4)
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @db.Decimal(12, 2) @default(0)
  taxAmount Decimal @db.Decimal(12, 2) @default(0)
  total     Decimal @db.Decimal(12, 2)

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  sale        Sale         @relation(fields: [saleId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])
  productUnit ProductUnit? @relation(fields: [productUnitId], references: [id])
}

model SalePayment {
  id        BigInt @id @default(autoincrement())
  saleId    BigInt
  paymentId BigInt

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  sale    Sale    @relation(fields: [saleId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])
}

model SaleReturn {
  id            BigInt           @id @default(autoincrement())
  saleId        BigInt
  returnNumber  String?          @unique
  returnDate    DateTime
  reason        String?
  subTotal      Decimal?         @db.Decimal(12, 2)
  taxTotal      Decimal?         @db.Decimal(12, 2)
  discountTotal Decimal?         @db.Decimal(12, 2)
  totalAmount   Decimal          @db.Decimal(12, 2)

  status    String    @default("Received")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  sale  Sale             @relation(fields: [saleId], references: [id])
  items SaleReturnItem[]
}

model SaleReturnItem {
  id            BigInt         @id @default(autoincrement())
  saleReturnId  BigInt
  productId     BigInt
  productUnitId BigInt?
  quantity      Decimal        @db.Decimal(12, 4)
  unitPrice     Decimal        @db.Decimal(12, 2)
  taxAmount     Decimal        @db.Decimal(12, 2) @default(0)
  discount      Decimal        @db.Decimal(12, 2) @default(0)
  total         Decimal        @db.Decimal(12, 2)

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])
}

model Quotation {
  id              BigInt          @id @default(autoincrement())
  quotationNumber String          @unique
  customerId      Int?
  branchId        Int?
  warehouseId     Int?
  date            DateTime
  expiryDate      DateTime?
  status          String          @default("Sent") // Sent, Ordered, Pending, Expired, Accepted
  subTotal        Decimal         @db.Decimal(12, 2)
  taxTotal        Decimal         @db.Decimal(12, 2) @default(0)
  discountTotal   Decimal         @db.Decimal(12, 2) @default(0)
  shipping        Decimal         @db.Decimal(12, 2) @default(0)
  grandTotal      Decimal         @db.Decimal(12, 2)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  version         Int             @default(1)
  deviceId        String?

  customer Customer?       @relation(fields: [customerId], references: [id])
  items    QuotationItem[]
}

model QuotationItem {
  id            BigInt    @id @default(autoincrement())
  quotationId   BigInt
  productId     BigInt
  productUnitId BigInt?
  quantity      Decimal   @db.Decimal(12, 4)
  unitPrice     Decimal   @db.Decimal(12, 2)
  discount      Decimal   @db.Decimal(12, 2) @default(0)
  taxAmount     Decimal   @db.Decimal(12, 2) @default(0)
  total         Decimal   @db.Decimal(12, 2)

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  quotation Quotation @relation(fields: [quotationId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
}

model PurchaseOrder {
  id            BigInt              @id @default(autoincrement())
  orderNumber   String              @unique
  supplierId    Int?
  branchId      Int?
  warehouseId   Int?
  orderDate     DateTime
  expectedDate  DateTime?
  status        String              @default("Ordered") // Ordered, Pending, Received, Cancelled
  subTotal      Decimal             @db.Decimal(12, 2)
  taxTotal      Decimal             @db.Decimal(12, 2) @default(0)
  discountTotal Decimal             @db.Decimal(12, 2) @default(0)
  shipping      Decimal             @db.Decimal(12, 2) @default(0)
  grandTotal    Decimal             @db.Decimal(12, 2)
  notes         String?             @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  version       Int                 @default(1)
  deviceId      String?

  supplier Supplier?           @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              BigInt        @id @default(autoincrement())
  purchaseOrderId BigInt
  productId       BigInt
  productUnitId   BigInt?
  quantity        Decimal       @db.Decimal(12, 4)
  unitPrice       Decimal       @db.Decimal(12, 2)
  discount        Decimal       @db.Decimal(12, 2) @default(0)
  taxAmount       Decimal       @db.Decimal(12, 2) @default(0)
  total           Decimal       @db.Decimal(12, 2)

  status    String        @default("ACTIVE")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
}

model Payment {
  id              BigInt   @id @default(autoincrement())
  paymentDate     DateTime @default(now())
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethod   String
  referenceNumber String?
  type            String?  @default("receive")
  notes           String?
  customerId      Int?
  supplierId      Int?

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  customer         Customer?         @relation(fields: [customerId], references: [id])
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  purchasePayments PurchasePayment[]
  salePayments     SalePayment[]
}

model Expense {
  id          BigInt   @id @default(autoincrement())
  branchId    Int
  userId      Int
  expenseDate DateTime
  amount      Decimal  @db.Decimal(12, 2)
  category    String
  description String?

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  branch Branch @relation(fields: [branchId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

// ==========================================
// INVENTORY
// ==========================================

model StockTransaction {
  id              BigInt @id @default(autoincrement())
  productId       BigInt
  warehouseId     Int?
  transactionType String
  referenceId     String?

  unitId       Int?
  unitQuantity Decimal @db.Decimal(12, 4)
  baseQuantity Decimal @db.Decimal(12, 4)

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  product   Product    @relation(fields: [productId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  unit      Unit?      @relation(fields: [unitId], references: [id])

  @@index([productId, warehouseId])
}

model StockBalance {
  id          BigInt  @id @default(autoincrement())
  productId   BigInt
  warehouseId Int
  quantity    Decimal @db.Decimal(12, 4)

  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
}

// ==========================================
// INVOICE SETTINGS
// ==========================================

model InvoiceTemplate {
  id          Int    @id @default(autoincrement())
  name        String
  contentHtml String @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  settings InvoiceTemplateSetting[]
}

model InvoiceTemplateSetting {
  id         Int    @id @default(autoincrement())
  templateId Int
  key        String
  value      String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)
  deviceId  String?

  template InvoiceTemplate @relation(fields: [templateId], references: [id])
}

// ==========================================
// SYNC LOGIC & AUDIT
// ==========================================

model SyncQueue {
  id          BigInt  @id @default(autoincrement())
  entityType  String
  entityId    String
  action      String
  payload     Json?
  status      String  @default("PENDING")
  errorReason String?
  deviceId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model SyncCursor {
  id           Int      @id @default(autoincrement())
  deviceId     String?
  entityType   String
  lastSyncedAt DateTime

  @@unique([deviceId, entityType])
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     Int?
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
}

model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  token     String   @unique
  userId    Int
  deviceId  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])
}
